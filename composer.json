{
    "name": "ihela/api-client",
    "description": "PHP SDK for the iHela Credit Union API for financial services in Burundi. Framework-agnostic — works with Laravel, Symfony, or any PHP application.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ihela",
        "burundi",
        "banking",
        "payments",
        "mobile-money",
        "api-client",
        "oauth2",
        "financial-services"
    ],
    "authors": [
        {
            "name": "UbuhingaVizion",
            "email": "info@ubuviz.com",
            "homepage": "https://ubuviz.com"
        }
    ],
    "support": {
        "issues": "https://github.com/UbuhingaVizion/ihela-php-client/issues",
        "source": "https://github.com/UbuhingaVizion/ihela-php-client",
        "docs": "https://UbuhingaVizion.github.io/ihela-php-client/"
    },
    "autoload": {
        "psr-4": {
            "Ihela\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ihela\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "guzzlehttp/guzzle": "^7.8",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Recommended PSR-18 HTTP client (^7.8)"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint-fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "audit": "composer audit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
